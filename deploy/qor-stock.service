[Unit]
Description=QorStock workspace
After=network.target

[Service]
Type=simple
User=qor-stock
Group=qor-stock
WorkingDirectory=/opt/qor-stock
EnvironmentFile=/etc/qor-stock.env
ExecStartPre=/usr/local/bin/node scripts/preflight.mjs
ExecStart=/usr/local/bin/node start.js
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=3
TimeoutStopSec=10
UMask=0077
StateDirectory=qor-stock
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
